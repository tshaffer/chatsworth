{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug chatsworth",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/backend/src/server.ts",
      "preLaunchTask": "tsc: build - backend",
      "outFiles": [
        "${workspaceFolder}/backend/dist/**/*.js"
      ],
      "cwd": "${workspaceFolder}/backend",
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register/transpile-only"
      ],
      "envFile": "${workspaceFolder}/backend/.env",
      "runtimeExecutable": "node",
      "sourceMaps": true
    },
    {
      "name": "Run importChats (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/importChats.ts",
        "--chatsDirectory=/Users/tedshaffer/Documents/ChatGPTExports/chatsworth",
        "--projectName=chatsworth"
      ],
      "console": "integratedTerminal"
    }
  ]
}
