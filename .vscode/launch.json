{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug chatsworth",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/backend/src/server.ts",
      "preLaunchTask": "tsc: build - backend",
      "outFiles": [
        "${workspaceFolder}/backend/dist/**/*.js"
      ],
      "cwd": "${workspaceFolder}/backend",
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register/transpile-only"
      ],
      "envFile": "${workspaceFolder}/backend/.env",
      "runtimeExecutable": "node",
      "sourceMaps": true
    },
    {
      "name": "Run syncChatsworthFromExport (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/sync-chatsworth-from-export.ts",
        "--full",
        "/Users/tedshaffer/Documents/Projects/chatgpt-export-parser/data/chatGPTExport-08-24-25-0/conversations-with-projects.json"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Run dryRun syncChatsworthFromExport (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/sync-chatsworth-from-export.ts",
        "--full",
        "/Users/tedshaffer/Documents/Projects/chatgpt-export-parser/data/chatGPTExport-08-24-25-0/conversations-with-projects.json",
        "--dry-run"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Run importFromChatGPT (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/import-conversations-to-db.ts",
        "/Users/tedshaffer/Documents/Projects/chatgpt-export-parser/data/chatGPTExport-08-23-25-0/conversations-with-projects.json"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Run importChats (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/importChats.ts",
        "--chatsDirectory=/Users/tedshaffer/Documents/ChatGPTExports/shafferography",
        "--projectName=shafferography"
      ],
      "console": "integratedTerminal"
    }
  ]
}