{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug chatsworth",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/backend/src/server.ts",
      "preLaunchTask": "tsc: build - backend",
      "outFiles": [
        "${workspaceFolder}/backend/dist/**/*.js"
      ],
      "cwd": "${workspaceFolder}/backend",
      "runtimeArgs": [
        "--nolazy",
        "-r",
        "ts-node/register/transpile-only"
      ],
      "envFile": "${workspaceFolder}/backend/.env",
      "runtimeExecutable": "node",
      "sourceMaps": true
    },
    {
      "name": "Dry run syncBidirectional (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/syncBidirectional.fromConversations.ts",
        "/Users/tedshaffer/Documents/Projects/chatgpt-export-parser/data/chatGPTExport-08-25-25-0/conversations-with-projects.json",
        "--dryRun",
        "--logDiffs"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true
    },
    {
      "name": "Run syncBidirectional (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/syncBidirectional.fromConversations.ts",
        "/Users/tedshaffer/Documents/Projects/chatgpt-export-parser/data/chatGPTExport-08-25-25-0/conversations-with-projects.json",
        "--logDiffs"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true
    },
    {
      "name": "Run importFromChatGPT (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
      ],
      "args": [
        "backend/src/scripts/import-conversations-to-db.ts",
        "/Users/tedshaffer/Documents/Projects/chatgpt-export-parser/data/chatGPTExport-08-24-25-0/conversations-with-projects.json",
        "--path=main",
        "--assistantPolicy=keep-latest",
        "--userDraftPolicy=keep-each",
        "--includeSystemInPrompt=false",
        "--includeToolInResponse=true",
        "--keepEmptyAssistant=true",
        "--titlePolicy=prefer-conv-title",
        "--includeToolInResponse=true"
      ],
      "console": "integratedTerminal"
    }
  ]
}